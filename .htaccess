DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /jpromanonet/

    # Prefer PHP index when both exist
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.php -f
    RewriteRule ^(.*)$ $1/index.php [L]

    # Custom CMS pages without a physical folder
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !/microCMS/
    RewriteRule ^([a-z0-9-]+)/?$ microCMS/public/page.php?slug=$1 [L,QSA,NC]
</IfModule>

# Fallback when rewrite is restricted: route missing pretty URLs to CMS
ErrorDocument 404 /jpromanonet/microCMS/public/router.php

# Security headers (best-effort)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
